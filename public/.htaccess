# ==========================================================================
# hnojaeger.de — Strato Webspace (Apache)
# Liegt in public/ und landet dadurch unverändert in dist/.
# ==========================================================================

# --- HTTPS und kanonische Domain ohne www --------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://hnojaeger.de/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.hnojaeger\.de$ [NC]
  RewriteRule ^(.*)$ https://hnojaeger.de/$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# --- Kompression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # WOFF2, AVIF, WebP und JPEG sind bereits komprimiert – nicht erneut packen.
</IfModule>

# --- Caching --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Astro versioniert alles unter /_astro/ über den Dateinamen – unbegrenzt cachebar.
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Sicherheits-Header -------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # HSTS: nach dem Go-live und geprüftem Zertifikat auf 31536000 erhöhen.
  # Vorher bewusst kurz, damit ein Zertifikatsproblem nicht ein Jahr nachwirkt.
  Header always set Strict-Transport-Security "max-age=300"
</IfModule>

# --- MIME-Typen, die Strato nicht zuverlässig mitbringt --------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# --- Verzeichnislisten aus ------------------------------------------------
Options -Indexes
