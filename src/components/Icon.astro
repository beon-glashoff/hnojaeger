---
/**
 * Tabler-Icons, lokal aus src/icons/ inline eingebettet.
 * Kein Netzwerkzugriff, kein zusätzlicher Request, färbbar über currentColor.
 */
interface Props {
  name: string;
  size?: string;
  class?: string;
}

const { name, size, class: className } = Astro.props;

const files = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const key = `../icons/${name}.svg`;
const raw = files[key];

if (!raw) {
  throw new Error(
    `Icon "${name}" fehlt in src/icons/. Vorhanden: ${Object.keys(files)
      .map((k) => k.replace('../icons/', '').replace('.svg', ''))
      .join(', ')}`
  );
}

// Tabler-Klassen entfernen, eigene Klassen und Größe setzen, dekorativ auszeichnen
const svg = raw
  .replace(/\n\s+/g, ' ')
  .replace(/\s*class="[^"]*"/, '')
  .replace(/\s*width="[^"]*"/, '')
  .replace(/\s*height="[^"]*"/, '')
  .replace(
    '<svg',
    `<svg aria-hidden="true" focusable="false" class="icon ${className ?? ''}"${
      size ? ` style="width:${size};height:${size}"` : ''
    }`
  );
---

<Fragment set:html={svg} />
