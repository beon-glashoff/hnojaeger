---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import heroQuer from '../assets/images/hero-quer.jpg';
import heroHoch from '../assets/images/hero-hoch.png';
import { site, taetigkeitsorte } from '../data/site';
import { schwerpunkte, leistungsspektrum, vita, qualifikationen } from '../data/content';

/**
 * Hauptvariante (vormals „Variante B · Nocturne")
 *
 * Unterschied zu A ist nicht nur die Farbe, sondern die Gliederung:
 * kein Kachelraster, sondern durchlaufende Bänder über die volle Breite.
 * Die Schwerpunkte werden zur nummerierten Liste, die Vita zur zweispaltigen
 * Zeitachse mit großen Jahreszahlen. Ein einziges helles Band setzt die Zäsur.
 */

/*
 * Art Direction für den Vollbild-Hero: Das Querformat trägt den
 * Desktop — sie steht links, der Text sitzt rechts im Raum. In einen hohen
 * Telefonausschnitt gerechnet würde derselbe Anschnitt sie zerschneiden,
 * deshalb liefert Mobil das Hochformat. `<picture>` ist hier handgebaut,
 * weil Astros <Picture> nur eine Quelle kennt — so lädt auch nur eine Datei.
 */
const wide = await Promise.all(
  [720, 1000, 1280, 1572].map((w) =>
    getImage({ src: heroQuer, width: w, format: 'avif', quality: 74 })
  )
);
const wideWebp = await Promise.all(
  [720, 1000, 1572].map((w) =>
    getImage({ src: heroQuer, width: w, format: 'webp', quality: 76 })
  )
);
/* Für den Telefonausschnitt gibt es eine eigene Aufnahme im Hochformat
   (1086 × 1540). Derselbe Moment wie im Querformat, nur anders gerahmt —
   beschnitten wirkte das Querformat auf dem Telefon beliebig. */
const tall = await Promise.all(
  [540, 760, 1086].map((w) =>
    getImage({ src: heroHoch, width: w, format: 'avif', quality: 74 })
  )
);
const tallWebp = await Promise.all(
  [540, 760, 1086].map((w) =>
    getImage({ src: heroHoch, width: w, format: 'webp', quality: 76 })
  )
);
const fallback = await getImage({ src: heroQuer, width: 1572, format: 'jpeg', quality: 76 });

const srcset = (imgs: { src: string; attributes?: Record<string, unknown> }[], widths: number[]) =>
  imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');

const MOBILE = '(max-width: 47.999rem)';
const DESKTOP = '(min-width: 48rem)';

/*
 * Dieselbe Art Direction für die vier Kacheln: Einspaltig auf dem Telefon
 * trägt das Querformat, ab zwei Spalten steht wieder das Hochformat. Der
 * Umschaltpunkt ist derselbe, an dem das Raster von einer auf zwei Spalten
 * geht (40rem) — sonst stünde ein Querformat in einer schmalen Spalte.
 */
/*
 * Die Kompetenzen stehen alphabetisch — bei einer Schlagwortliste, die
 * überflogen wird, ist das die einzige Ordnung, die jemand ohne Erklärung
 * findet. `localeCompare` mit 'de', damit Umlaute einsortiert werden und
 * nicht hinten landen.
 *
 * Sieben Gruppen ergäben im dreispaltigen Raster zweieinhalb Zeilen, die
 * letzte stünde allein. Deshalb teilen sich zwei Gruppen eine Zelle und
 * stehen dort untereinander. Welche beiden, steht hier ausdrücklich statt
 * gerechnet: Es sind die beiden kürzesten, aber sie stehen alphabetisch
 * nicht nebeneinander. „Nase und Nebenhöhlen" rückt deshalb aus seiner
 * Position nach vorn in die Zelle von „Botulinumtoxin"; alle übrigen
 * Gruppen bleiben in der alphabetischen Folge.
 */
const PAAR = ['Botulinumtoxin', 'Nase und Nebenhöhlen'] as const;

const kompetenzenAlphabetisch = [...leistungsspektrum].sort((a, b) =>
  a.titel.localeCompare(b.titel, 'de')
);

const partner = kompetenzenAlphabetisch.find((g) => g.titel === PAAR[1]);
if (!partner || !kompetenzenAlphabetisch.some((g) => g.titel === PAAR[0])) {
  // Lieber der Build als eine Übersicht, die unbemerkt auseinanderfällt.
  throw new Error(`Kompetenzen: Gruppe aus PAAR nicht gefunden (${PAAR.join(', ')})`);
}

const kompetenzSpalten = kompetenzenAlphabetisch.flatMap((gruppe) => {
  if (gruppe.titel === PAAR[1]) return [];
  return [gruppe.titel === PAAR[0] ? [gruppe, partner] : [gruppe]];
});

const KACHEL_SCHMAL = '(max-width: 39.999rem)';
const KACHEL_BREIT = '(min-width: 40rem)';
const KACHEL_QUER = [540, 760, 1080];
const KACHEL_HOCH = [360, 540, 760, 1024];
const KACHEL_GROESSEN = '(min-width: 64rem) 24vw, (min-width: 40rem) 46vw, 100vw';

const kacheln = await Promise.all(
  schwerpunkte.map(async (s) => {
    const satz = (src: ImageMetadata, breiten: number[], format: 'avif' | 'webp') =>
      Promise.all(
        breiten.map((width) =>
          getImage({ src, width, format, quality: format === 'avif' ? 72 : 74 })
        )
      );
    return {
      querAvif: await satz(s.bildQuer, KACHEL_QUER, 'avif'),
      querWebp: await satz(s.bildQuer, KACHEL_QUER, 'webp'),
      hochAvif: await satz(s.bild, KACHEL_HOCH, 'avif'),
      hochWebp: await satz(s.bild, KACHEL_HOCH, 'webp'),
      rueckfall: await getImage({ src: s.bild, width: 760, format: 'jpeg', quality: 74 }),
    };
  })
);
---

<BaseLayout
  variant="dunkel"
  headerOverlay
  modeToggle
  profilePage
  title="Dr. med. Anne Jäger – Fachärztin für HNO-Heilkunde"
  description="Dr. med. Anne Jäger ist Fachärztin für Hals-Nasen-Ohrenheilkunde mit den Schwerpunkten Allergologie, Kinder-HNO, Präventivmedizin, schlafmedizinische Diagnostik und ästhetische Medizin. Derzeit tätig in Köln-Rodenkirchen und Hennef."
>
  {/* ======================================== Hero: Vollbild mit Verlauf */}
  <section class="hero">
    <picture class="hero__pic">
      <source media={MOBILE} type="image/avif" srcset={srcset(tall, [540, 760, 1086])} sizes="100vw" />
      <source media={MOBILE} type="image/webp" srcset={srcset(tallWebp, [540, 760, 1086])} sizes="100vw" />
      <source media={DESKTOP} type="image/avif" srcset={srcset(wide, [720, 1000, 1280, 1572])} sizes="100vw" />
      <source media={DESKTOP} type="image/webp" srcset={srcset(wideWebp, [720, 1000, 1572])} sizes="100vw" />
      <img
        src={fallback.src}
        alt={`${site.name}, ${site.role}`}
        width={1572}
        height={1136}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero__img"
      />
    </picture>

    <div class="hero__veil" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__h1">
          <span class="hero__name">{site.nameShort}</span>
          <span class="hero__role label">{site.role}</span>
        </h1>
        <p class="lead hero__lead">
          Allergologie, Kinder-HNO, Präventivmedizin, schlafmedizinische
          Diagnostik und ästhetische Medizin.
        </p>
      </div>
    </div>
  </section>

  {/* ===================================================== Statement */}
  <section class="section section--subtle">
    <div class="container">
      {/* Der Name steht jetzt über dem Zitat statt darunter; die frühere
          Signaturzeile wäre daneben eine Dopplung. */}
      <p class="label reveal">Dr. med. Anne Jäger</p>
      <blockquote class="statement reveal">
        Mein Blick geht über die Behandlung akuter Beschwerden hinaus:
        Gesundheit erhalten, Risiken früh erkennen, Erkrankungen vorbeugen.
        Vor allem aber möchte ich eines — Ihnen zuhören, Ihre Anliegen
        verstehen und mir Zeit für Sie nehmen.
      </blockquote>
    </div>
  </section>

  {/* ===================================== Schwerpunkte: breite Bänder */}
  {/* Über die volle Fensterbreite: Auf dunklem Grund brauchen die Bilder
      Fläche, um zu tragen. Der Fließtext bleibt trotzdem auf Lesemaß
      begrenzt — ein 700 px breiter Absatz wäre nicht mehr lesbar. */}
  <section class="section" id="schwerpunkte">
    <div class="container">
      {/* Diese Sektion war als einzige ohne Überschrift – im Dokumentumriss
          eine Lücke zwischen H1 und den folgenden H2. */}
      <p class="label reveal">Schwerpunkte</p>
      <h2 class="h2 sec__title reveal">Was mir besonders am Herzen liegt</h2>

      <ul class="rows reveal">
        {schwerpunkte.map((s, i) => (
          <li class="row">
            <a href={`/leistungen/${s.slug}/`} class="row__link">
              <span class="row__media">
                <picture class="row__pic">
                  <source media={KACHEL_SCHMAL} type="image/avif" srcset={srcset(kacheln[i].querAvif, KACHEL_QUER)} sizes="100vw" />
                  <source media={KACHEL_SCHMAL} type="image/webp" srcset={srcset(kacheln[i].querWebp, KACHEL_QUER)} sizes="100vw" />
                  <source media={KACHEL_BREIT} type="image/avif" srcset={srcset(kacheln[i].hochAvif, KACHEL_HOCH)} sizes={KACHEL_GROESSEN} />
                  <source media={KACHEL_BREIT} type="image/webp" srcset={srcset(kacheln[i].hochWebp, KACHEL_HOCH)} sizes={KACHEL_GROESSEN} />
                  <img
                    src={kacheln[i].rueckfall.src}
                    alt={s.bildAlt}
                    width={1024}
                    height={1536}
                    loading="lazy"
                    decoding="async"
                    class="row__img"
                  />
                </picture>
                <span class="row__arrow"><Icon name="arrow-narrow-right" /></span>
              </span>

              <span class="row__body">
                <span class="label row__kicker">{s.kurz}</span>
                <span class="row__title">{s.titel}</span>
                <span class="row__text">{s.kurztext}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================ Leistungsspektrum */}
  <section class="section section--subtle" id="leistungen">
    <div class="container">
      <p class="label reveal">Kompetenzen</p>
      <h2 class="h2 sec__title reveal">Ihre Gesundheit im Fokus</h2>

      <dl class="spektrum reveal">
        {kompetenzSpalten.map((spalte) => (
          <div class="spektrum__row">
            {spalte.map((g) => (
              <div class="spektrum__block">
                <dt class="label spektrum__group">
                  <Icon name={g.icon} class="spektrum__icon" />
                  <span>{g.titel}</span>
                </dt>
                <dd class="spektrum__items">
                  <ul class="spektrum__list">
                    {g.punkte.map((punkt) => <li>{punkt}</li>)}
                  </ul>
                </dd>
              </div>
            ))}
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ============================================ Vita: große Jahreszahlen */}
  <section class="section" id="vita">
    <div class="container">
      <p class="label reveal">Werdegang</p>
      <h2 class="h2 sec__title reveal">Vita</h2>

      {vita.map((gruppe) => (
        <div class="vita reveal">
          <h3 class="label vita__group">{gruppe.titel}</h3>
          <ol class="vita__list">
            {gruppe.stationen.map((st) => (
              <li class="vita__item">
                <span class="vita__jahr">{st.jahr}</span>
                <span class="vita__body">
                  <span class="vita__text">{st.text}</span>
                  {st.ort && <span class="small vita__ort">{st.ort}</span>}
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))}

      <p class="quali reveal">
        {qualifikationen.map((q, i) => (
          <>
            {i > 0 && <span class="quali__sep" aria-hidden="true"> · </span>}
            <span class="quali__item">{q}</span>
          </>
        ))}
      </p>
    </div>
  </section>

  {/* ====================== Sprechstunden: die einzige helle Zäsur */}
  <section class="section bright" id="sprechstunden">
    <div class="container">
      <p class="label bright__label">Sprechstunden</p>
      <h2 class="h2 sec__title bright__title">Wo Sie mich momentan erreichen</h2>

      <ul class="orte">
        {taetigkeitsorte.map((o) => {
          const Wrapper = o.url ? 'a' : 'div';
          return (
            <li class="ort">
              <Wrapper
                class="ort__inner"
                {...(o.url
                  ? {
                      href: o.url,
                      rel: 'noopener',
                      target: '_blank',
                      'aria-label': `${o.praxis}, ${o.ort} — Praxis-Website öffnen`,
                    }
                  : {})}
              >
                <span class="label ort__seit">{o.seit}</span>
                <span class="ort__main">
                  <span class="ort__name">{o.praxis}</span>
                  <span class="small ort__inhaber">{o.inhaber}</span>
                </span>
                {/* Der Ort steht in der letzten Zeile statt hinter den Inhabern:
                    Wer die Sprechstunden liest, sucht zuerst, wo das ist. */}
                <span class="small ort__standort">
                  <Icon name="map-pin" />
                  <span>{o.ort}</span>
                </span>
                {o.url && <span class="ort__arrow"><Icon name="arrow-narrow-right" /></span>}
              </Wrapper>
            </li>
          );
        })}
      </ul>

      {/* Rechtlich relevant (Fernbehandlungsverbot) – steht deshalb dort,
          wo jemand über eine Kontaktaufnahme nachdenkt, und nicht im Footer.
          Bewusst als ruhiger Nachsatz gesetzt. */}
      <p class="note">
        Über diese Seite ist keine medizinische Beratung möglich — bitte
        vereinbaren Sie dafür einen Termin in einer der Praxen, in denen ich
        tätig bin. In dringenden Fällen wenden Sie sich an den ärztlichen
        Bereitschaftsdienst unter 116 117, im Notfall an 112.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .sec__title { margin-top: var(--s-4); margin-bottom: var(--s-16); }

  /* --------------------------------------------- Hero: Vollbild */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    /* Feste Tinte: Der Hero liegt in beiden Farbmodi auf einem dunklen
       Verlauf über dem Foto – hier darf nichts umschlagen. */
    color: #E7E7E3;
  }

  .hero__pic {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
  }

  /*
   * Die frühere Aufnahme für das Telefon war mit 898 × 1751 höher als
   * jeder Telefonausschnitt; sie musste über einen negativen `inset`
   * angehoben werden. Die jetzige ist 1086 × 1540 und damit flacher: Sie
   * füllt die Höhe exakt aus, und derselbe Kniff schnitte ihr den Kopf ab.
   * Deshalb liegt sie bündig im Ausschnitt.
   */
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    /* Sehr langsam und nur 4 % – die Bewegung soll man eher spüren
       als sehen. Läuft einmal und bleibt dann stehen. */
    animation: hero-zoom 26s var(--ease) forwards;
  }

  @keyframes hero-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img { animation: none; }
  }

  /*
   * Der Verlauf trägt die Lesbarkeit, nicht ein Textschatten.
   * Mobil von unten, ab 60rem von rechts — dort steht sie links im Bild.
   * Gemessen gegen die hellste denkbare Bildstelle (Weiß) ergibt die
   * Enddeckkraft 0,88 einen Grund von ~#3B3E42: Light Sage erreicht
   * darauf 8,5:1, der Sekundärton 5,0:1.
   */
  /* Mobil steht der Header mittig – dort braucht es weiterhin einen
     durchgehenden Scrim, sonst läge die Navigation ungeschützt auf dem Bild. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        rgba(34, 38, 42, 0.92) 0%,
        rgba(34, 38, 42, 0.82) 34%,
        rgba(34, 38, 42, 0.28) 62%,
        rgba(34, 38, 42, 0) 88%
      ),
      /* Scrim für die transparente Navigation */
      linear-gradient(
        to bottom,
        rgba(34, 38, 42, 0.85) 0,
        rgba(34, 38, 42, 0.78) 5.5rem,
        rgba(34, 38, 42, 0) 14rem
      );
  }

  @media (min-width: 60rem) {
    .hero__img { object-position: 30% 26%; }   /* Querformat: sie steht links */
    /*
     * Kein Verlauf über die ganze Breite, sondern drei Kegel aus den Ecken.
     * Zusammen ergeben sie ein helles Feld, das um sie herum liegt und nach
     * außen dunkler wird — links unten läuft es offen aus, dort trägt das
     * einfallende Licht das Bild und soll es weiter tun.
     *
     * Die Deckkraft ist gegen die hellste Bildstelle der jeweiligen Ecke
     * gerechnet, nicht nach Augenmaß.
     */
    .hero__veil {
      background:
        /* Rechts unten: trägt Name, Rolle und Vorspann. Der Kegel hält seine
           Deckkraft bis 50 % des Radius, damit die ganze Textspalte auf
           demselben Grund steht und nicht die letzte Zeile heller wird.
           Gemessen über der Textfläche: Name 10,0:1, Vorspann 7,4:1. Bei
           42 % fiel der Vorspann auf 5,5:1 — das trägt, ist aber weniger,
           als die Seite sonst hält. Weiter aufgezogen (56 % und mehr)
           steigt die Deckkraft links unten spürbar an; dort soll das
           einfallende Licht stehen bleiben. */
        radial-gradient(
          85% 95% at 100% 100%,
          rgba(34, 38, 42, 0.93) 0%,
          rgba(34, 38, 42, 0.90) 50%,
          rgba(34, 38, 42, 0.54) 72%,
          rgba(34, 38, 42, 0.18) 88%,
          rgba(34, 38, 42, 0) 100%
        ),
        /* Rechts oben: trägt die Navigation. Die neue Aufnahme ist dort
           deutlich heller als die vorige — mit den alten Werten fiel die
           Navigation auf 5,0:1. Weiter aufgezogen (66 %) läge ein Schleier
           über der Bildmitte; bei diesen Werten bleibt sie frei. */
        radial-gradient(
          62% 50% at 100% 0%,
          rgba(34, 38, 42, 0.88) 0%,
          rgba(34, 38, 42, 0.50) 50%,
          rgba(34, 38, 42, 0) 80%
        ),
        /* Hinter der Wortmarke liegt ein Fenster – gemessen der hellste
           Punkt der ganzen Fläche. Der Kegel muss ihn tragen: bei 0,88 im
           Zentrum bleibt dort ein Grund von ~#4E5153, die Marke erreicht
           5,9:1. Mit dem ersten Entwurf waren es nur 3,3:1. */
        radial-gradient(
          32% 34% at 0% 0%,
          rgba(34, 38, 42, 0.88) 0%,
          rgba(34, 38, 42, 0.74) 34%,
          rgba(34, 38, 42, 0.36) 56%,
          rgba(34, 38, 42, 0) 80%
        );
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    padding-block: clamp(var(--s-16), 10vh, var(--s-24));
  }
  @media (min-width: 60rem) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 32rem); }
    /*
     * Rechts unten statt rechts mittig: Der Name sitzt damit im dunkelsten
     * Teil des Bildes, und über ihm bleibt der Raum frei, in dem sie steht.
     * Das `align-items: end` des Hero gilt hier ohnehin — auf dem Desktop
     * stand es früher auf `center`.
     */
    .hero__text { grid-column: 2; }
  }

  .hero__h1 { display: grid; gap: var(--s-4); }
  /*
   * Versalien wie in der Wortmarke. `text-transform` statt Großbuchstaben
   * im Text: Im Dokument steht weiter „Dr. Anne Jäger", und Vorleseprogramme
   * sprechen den Namen, statt ihn zu buchstabieren. Versalien brauchen
   * Laufweite statt der negativen Spationierung, die für Gemischtsatz
   * gesetzt war, und tragen bei gleicher Schriftgröße optisch weiter —
   * deshalb eine Stufe kleiner. Die Obergrenze ist gemessen, nicht
   * geschätzt: Mit dieser Laufweite bricht „DR. ANNE JÄGER" in der 32rem
   * breiten Textspalte ab 62 px um, deshalb 58 px als Obergrenze.
   */
  .hero__name {
    display: block;
    font-size: clamp(2rem, 1rem + 4.2vw, 3.625rem);
    font-weight: var(--fw-light);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  /*
   * Über dem Bild trägt der normale Sekundärton nicht. Gemessen: der hellste
   * Bildpunkt hinter der Textspalte ist ein Fenster mit #FCFEFF; nach dem
   * Verlauf bleibt ein Grund von ~#414448. Dort erreicht #B5B3AB nur 4,66:1
   * und wäre ohne den vertieften Verlauf durchgefallen. --hero-dim liegt
   * zwischen Sekundärton und Textton und hält 6,34:1.
   */
  .hero__text { --hero-dim: #D2D0C9; }
  .hero__role { display: block; color: var(--hero-dim); }
  .hero__lead { margin-top: var(--s-8); max-width: 34rem; color: var(--hero-dim); }

  /* -------------------------------------------------------- Statement */
  .statement {
    margin: var(--s-8) 0 var(--s-4);
    max-width: 44rem;
    font-size: clamp(1.375rem, 1.05rem + 1.4vw, 2rem);
    font-weight: var(--fw-light);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  /* --text-muted trägt im hellen Modus auf der gedämpften Fläche nicht
     (4,32:1 bei 15 px). Der Sekundärton hält in beiden Modi. */

  /* ------------------------------------ Schwerpunkte: vier Spalten */
  .rows {
    display: grid;
    /* Bewusst großzügiger als das Standardraster: Die vier Bereiche
       sollen als eigenständige Einheiten lesbar bleiben. */
    gap: var(--s-16) clamp(var(--s-8), 3.5vw, var(--s-16));
    margin-top: var(--s-16);
  }
  @media (min-width: 40rem) { .rows { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .rows { grid-template-columns: repeat(4, 1fr); } }

  /* Keine Kartenfläche und keine Rundung: Auf dunklem Grund stehen die
     Bilder frei, der Text darunter. Das hält B von der Kartenlogik der
     Variante C getrennt, obwohl beide vier Spalten zeigen. */
  .row__link {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--s-6);
    height: 100%;
    text-decoration: none;
  }

  .row__media { position: relative; display: block; overflow: hidden; }

  /*
   * Ersetzt die Beschriftung „Mehr dazu". Kein Kasten — stattdessen ein
   * Verlauf aus der unteren rechten Ecke, damit der Pfeil auf jedem Motiv
   * trägt. Gerechnet gegen den hellsten denkbaren Bildpunkt (#FCFEFF):
   * bei 0,72 Deckkraft bleibt ein Grund von ~#5F6266, der Pfeil erreicht
